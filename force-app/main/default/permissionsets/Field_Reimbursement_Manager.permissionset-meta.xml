<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Field Reimbursement Manager</label>
    <description>FRM access: read/edit Access and Reimbursement cases assigned to them, read plan context (not full edit), create tasks/events. Demonstrates security scenario where FRM sees only access cases, not full plan details.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Contact</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
    </objectPermissions>
    <objectPermissions>
        <object>Account</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
    </objectPermissions>
    <objectPermissions>
        <object>Care_Program__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
    </objectPermissions>
    <objectPermissions>
        <object>Affiliation__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
    </objectPermissions>
    <fieldPermissions>
        <field>Account.NPI_Number__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Account.Specialty__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Account.Site_Type__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Support_Category__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Support_Subcategory__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Resolution_Summary__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.External_Reference_Number__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <!-- FRM intentionally cannot edit PSP plan fields -->
    <fieldPermissions>
        <field>Case.Care_Program__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Primary_Care_Coordinator__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Enrollment_Source__c</field>
        <editable>false</editable>
        <readable>false</readable>
    </fieldPermissions>
</PermissionSet>
